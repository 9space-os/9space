#!/usr/bin/env bash
# mkfirmware [-n] [-u] [-o FILE]: the firmware archive: linux-firmware's WLAN and GPU
# firmware under the names the drivers read (tree/scripts/guest/firmware.spec),
# each file checked against firmware.list's sha256, with its licences
# (scripts/guest/stage-firmware.py: FWDIR, the host's /usr/lib/firmware by default).
# The firmware alone (the CDs and update archives carry it too, unless FIRMWARE=0):
# to bring a machine's firmware up to date, or one installed without it, as an update:
#
#	mkdir /tmp/fw && cd /tmp/fw && tar xzf /path/to/9space-firmware.tgz && rc apply.rc
#
# (apply.rc copies root/, i.e. /lib/firmware, over the system: dist/lib/updatepack.py).
#   -o FILE   default $CLI_DIR/9space-firmware.tgz
#   -n        stage and count, write no archive
#   -u        first make tree/scripts/guest/firmware.list anew from the linux-firmware
#             there now (stage-firmware.py -u), then the archive; commit the list
# Without -u a firmware file that is not as firmware.list has it (another
# linux-firmware, e.g. after the host's package update) stops it.
set -e
HERE=$(cd -P "$(dirname "$0")/.." && pwd -P)
usage(){ echo "usage: mkfirmware [-n] [-u] [-o file]" >&2; exit 2; }
dry=0 out= update=0
while [ $# -gt 0 ]; do
	case $1 in
	-n)	dry=1; shift ;;
	-u)	update=1; shift ;;
	-o)	[ $# -ge 2 ] || usage; out=$2; shift 2 ;;
	*)	usage ;;
	esac
done
TREE=$(cd -P "$HERE/.." && pwd -P)/$(sed -n 's/^TREE=//p' "$HERE/paths.env")
ROOT=$TREE
. "$TREE/scripts/lib/paths.sh"	# CLI_DIR (paths.env)
out=${out:-$CLI_DIR/9space-firmware.tgz}
stage=$CLI_DIR/firmware.stage

if [ $update = 1 ]; then
	list=$TREE/scripts/guest/firmware.list
	old=$(sed -n '1s/.*: //p' "$list")
	python3 "$TREE/scripts/guest/stage-firmware.py" -u
	echo "mkfirmware: firmware.list: $old -> $(sed -n '1s/.*: //p' "$list"), $(git -C "$TREE" diff --numstat -- scripts/guest/firmware.list | awk '{print $1 " lines changed"}')"
	echo "mkfirmware: commit it: git -C tree commit -m 'firmware.list: linux-firmware ...' scripts/guest/firmware.list"
fi
rm -rf "$stage" "$stage.list"
mkdir -p "$stage/lib"
python3 "$TREE/scripts/guest/stage-firmware.py" "$stage/lib/firmware"
# its list as stage-dist.sh writes it: path, mode (DMDIR for directories), owner, group
(cd "$stage" && find lib/firmware -type d -printf '%p\t20000000775\tsys\tsys\n' \
	-o -type f -printf '%p\t664\tsys\tsys\n') | LC_ALL=C sort > "$stage.list"

manifest=$(mktemp)
trap 'rm -f "$manifest"' EXIT
{
	echo "9space firmware: $(sed -n "1s/.*: //p" "$TREE/scripts/guest/firmware.list")"
	echo "made $(date -u +%Y-%m-%dT%H:%MZ)"
	echo "tree $(git -C "$TREE" log -1 --format=%h) (firmware.spec, firmware.list)"
} > "$manifest"
# no kernel in it: apply.rc copies /lib/firmware only
python3 "$HERE/lib/updatepack.py" "$stage" "$stage.list" "$out" amd64 "$manifest" "$dry"
