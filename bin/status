#!/usr/bin/env python3
"""status: each part of 9space (parts.PARTS) against manifest.json: its
branch and commit, and then = (the manifest's commit), +N (N commits after
it), differs (not after it), or "not pinned"; "no repository" with the path
where none is. Then the changed tracked files ("N changed"), those that
expected-changes allows counted apart. A branch of the tree without its
worktree: its ref in tree. Exit 1 if a pinned part is at another commit."""
import os, sys
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import parts

vals = parts.env()
man = parts.load()['parts']
bad = 0
for name, spec in parts.PARTS:
	d = parts.where(spec, vals)
	s = parts.state(d, name, vals)
	if s is None:
		print('%-18s %-10s %-12s %s' % (name, '-', 'no repository', d))
		continue
	m = man.get(name)
	if m is None:
		mark = 'not pinned'
	elif m['commit'] == s['commit']:
		mark = '='
	else:
		g, h = s['gitdir'], s['head']
		ahead = parts.git(g, 'rev-list', '--count', '%s..%s' % (m['commit'], h))
		mark = ('+%s' % ahead) if ahead is not None and parts.git(g, 'merge-base', '--is-ancestor', m['commit'], h) is not None else 'differs'
		bad += 1
	dirty = (' %d changed' % s['dirty']) if s['dirty'] else ''
	if s.get('expected'):
		dirty += ' (%d expected: expected-changes)' % s['expected']
	if not s['worktree']:
		dirty += ' (no worktree: the branch in tree)'
	print('%-18s %-10s %-12s %s%s' % (name, s['branch'], s['commit'][:10], mark, dirty))
sys.exit(1 if bad else 0)
