#!/usr/bin/env bash
# mkupdate [-n] [-dev gcc,rust,go,clang|all|none] [-mcp] [-browser] [-o FILE] PROFILE [ARCH]:
# an update archive for machines installed from a CD of that profile: the files the
# CD of the same options carries (sys/src/build/host/guest/stage-dist.sh, as mkcd stages them),
# from the main branch's build, without what an installed machine makes its own.
#
#   PROFILE, -dev, -mcp, -browser   as for dist/bin/mkcd (default -dev: all for full,
#                                   none for the others)
#   ARCH       amd64 (default) or 386
#   -o FILE    default $CLI_DIR/9space-update-PROFILE[-dev-LIST][-mcp][-browser].ARCH.tgz
#   -n         stage and list what would go in, write no archive
#
# With the firmware, as the CD (FIRMWARE=0: without; dist/bin/mkfirmware: the firmware alone).
# Left out (the machine's own after the installation): /adm (users, timezone
# setting), /cfg, /usr, /mail, /lib/ndb/local, /lib/ndb/auth, plan9.ini (in 9fat).
# The archive holds root/ (the files, with the CD's modes and owners), apply.rc and
# MANIFEST (the profile, the options and the parts' commits); root/sys/lib/dist/update
# is MANIFEST with the update's fingerprint (printed at the end, -n too: the same
# build, the same fingerprint; dist/bin/instance tells by it whether a machine has
# this build). On the machine:
#
#	mkdir /tmp/up && cd /tmp/up && tar xzf /path/to/the.tgz && rc apply.rc
#
# apply.rc copies root/ over / (the file server's permission checks off meanwhile:
# hjfs or cwfs "allow"), puts the kernel into 9fat (the old one as 9pc64.orig, 386:
# 9pc.orig) and says what to reboot into. The toolchains' trees (/$objtype/rust,
# go, gnu) are replaced whole; elsewhere it removes what the last update put on
# and this one no longer has (root/sys/lib/dist/update.files, the list of the
# update's paths, against the machine's from the last update; never the
# machine's own files above; `rc apply.rc -n` names them and stops). A machine
# installed from a CD has no list yet: its first update removes nothing.
# pull(1) (mkcd's replica) is the update over HTTP; this is the one without a network.
#
# With build-all's lock (unless the caller holds it: CHECK_LOCKED=1): the archive
# is made from the tree's build.
set -e
HERE=$(cd -P "$(dirname "$0")/.." && pwd -P)
usage(){ echo "usage: mkupdate [-n] [-dev gcc,rust,go,clang|all|none] [-mcp] [-browser] [-o file] minimal|gpu|ui|full [amd64|386]" >&2; exit 2; }
dev=- out= mcp= browser= dry=0
while [ $# -gt 0 ]; do
	case $1 in
	-n)	dry=1; shift ;;
	-dev)	[ $# -ge 2 ] || usage; dev=$2; shift 2 ;;
	-mcp)	mcp=1; shift ;;
	-browser) browser=1; shift ;;
	-o)	[ $# -ge 2 ] || usage; out=$2; shift 2 ;;
	-*)	usage ;;
	*)	break ;;
	esac
done
[ $# -ge 1 ] && [ $# -le 2 ] || usage
profile=$1 arch=${2:-amd64}
case $profile in minimal|gpu|ui|full) ;; *) usage ;; esac
case $arch in amd64|386) ;; *) echo "mkupdate: amd64 or 386, not $arch" >&2; exit 2 ;; esac
if [ -n "$browser" ]; then
	[ $profile = full ] || { echo "mkupdate: -browser needs the profile full" >&2; exit 2; }
	[ $arch = amd64 ] || { echo "mkupdate: -browser: the browser is built for amd64 only" >&2; exit 2; }
fi
if [ "$dev" = - ]; then
	[ $profile = full ] && dev=all || dev=none
fi
[ "$dev" = none ] && dev=
[ "$dev" = all ] && dev=gcc,rust,go,clang
for l in ${dev//,/ }; do
	case $l in gcc|rust|go|clang) ;; *) echo "mkupdate: -dev: no language $l (gcc, rust, go, clang)" >&2; exit 2 ;; esac
done

. "$HERE/lib/tree.sh"	# TREE, TREE_SCRIPTS; CLI_DIR, RUST_DIR, GO_DIR (paths.env)
name=9space-update-$profile
[ -n "$dev" ] && [ $profile != full -o "$dev" != gcc,rust,go,clang ] && name=$name-dev-${dev//,/-}
[ -n "$mcp" ] && name=$name-mcp
[ -n "$browser" ] && name=$name-browser
out=${out:-$CLI_DIR/$name.$arch.tgz}
stage=$CLI_DIR/update.$profile.$arch

if [ "$CHECK_LOCKED" != 1 ]; then	# check -instance holds it already
	exec 9>"$HERE/.build-all.lock"
	flock -n 9 || { echo "mkupdate: build-all, build-profile, mkcd or build-toolchains runs" >&2; exit 1; }
fi

# the CD's tree of these options (stage-dist.sh: DEV's languages from their out/$arch)
rm -rf "$stage" "$stage.list"
case ",$dev," in *,rust,*) export RUST_OUT=$RUST_DIR/out/$arch ;; esac
case ",$dev," in *,go,*) export GO_OUT=$GO_DIR/out/$arch ;; esac
case ",$dev," in *,clang,*) export CLANG_OUT=$CLANG_DIR/out/$arch ;; esac
PROFILE=$profile DEV=$dev MCP=$mcp BROWSER=$browser objtype=$arch \
	bash "$TREE_SCRIPTS/guest/stage-dist.sh" "$stage" >&2

manifest=$(mktemp)
trap 'rm -f "$manifest"' EXIT
{
	echo "9space update: profile $profile, arch $arch, dev ${dev:-none}${mcp:+, mcp}${browser:+, browser}"
	echo "made $(date -u +%Y-%m-%dT%H:%MZ)"
	python3 -c 'import json, sys
for k, v in sorted(json.load(open(sys.argv[1]))["parts"].items()):
	print("%-16s %s %s" % (k, v["branch"], v["commit"][:10]))' "$HERE/manifest.json"
} > "$manifest"

# root/ from the stage's list, apply.rc, MANIFEST (dist/lib/updatepack.py)
python3 "$HERE/lib/updatepack.py" "$stage" "$stage.list" "$out" "$arch" "$manifest" "$dry" 1
