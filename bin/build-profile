#!/usr/bin/env bash
# build-profile [-n] [-check] [-cd [MKCD-OPTION...]] PROFILE [ARCH...]: the tree for one installation
# profile, only what its CD has (tree/sys/src/build/host/guest/profiles), with the toolchains
# build-toolchains made. ARCH: amd64 (default), 386, arm64.
#
#   PROFILE   minimal  the base system: rio, VESA
#             gpu      + the GPU stack: Linux's DRM drivers on the LinuxKPI (i915,
#                      amdgpu), Mesa (APE, the cross gcc)
#             ui       + the desktop: APE's ports (Wayland, foot, the fonts' libraries,
#                      Mesa for wsys), the Rust programs (wsys, ui, term)
#             full     gpu and ui: the whole tree
#
# The groups of build.$ARCH.json (dist/lib/tree-build.sh) each profile builds:
#
#   all       prep libc libs klibs cmds kernelgen kernel, the install step's
#             kernel a.out; amd64: of linux the LinuxKPI and aux/rtw89 (WLAN, on
#             every CD)
#   gpu       linux (aux/i915, aux/amdgpu), ape
#   ui        ape, rust
#
# Then sys/src/build/step/check-install.py -r -x: everything the profile has is there, what
# it leaves out is not missing (CACHE/build/PROFILE.ARCH.omitted). The output goes to
# the terminal; -n prints the steps only. -cd then makes the CD of each ARCH (amd64,
# 386) with dist/bin/mkcd, the options before PROFILE handed on (-dev, -mcp,
# -browser, -ini, -o, -noreplica).
#
# -check: then dist/bin/check static guest boot kencc gccmk (the static tests, the
# guest's, 9front's mkfiles with kencc and gccmk; check-install above stands for
# its stage build, which wants the whole tree); a failure stops before the CD.
# With -cd, check -iso on each CD it made.
#
# One run at a time, and not with build-all or mkcd (build-all's lock).
set -e
HERE=$(cd -P "$(dirname "$0")/.." && pwd -P)
usage(){ echo "usage: build-profile [-n] [-check] [-cd [-dev LIST] [-mcp] [-browser] [-ini 'name=value'] [-o iso] [-noreplica]] minimal|gpu|ui|full [amd64|386|arm64...]" >&2; exit 2; }
dry=0 cd=0 check=0 mkcd=()
while [ $# -gt 0 ]; do
	case $1 in
	-n)	dry=1; shift ;;
	-check)	check=1; shift ;;
	-cd)	cd=1; shift ;;
	-dev|-ini|-o)	[ $# -ge 2 ] || usage; mkcd+=("$1" "$2"); shift 2 ;;
	-mcp|-browser|-noreplica)	mkcd+=("$1"); shift ;;
	-*)	usage ;;
	*)	break ;;
	esac
done
[ $# -ge 1 ] || usage
profile=$1; shift
case $profile in
minimal|gpu|ui|full) ;;
nix) echo "build-profile: nix is the tree's branch nix: wiki Building, \"Installation profiles\"" >&2; exit 2 ;;
*) usage ;;
esac
[ ${#mkcd[@]} = 0 ] || [ $cd = 1 ] || { echo "build-profile: ${mkcd[*]}: mkcd's options, with -cd" >&2; exit 2; }
arches=("$@")
[ ${#arches[@]} -gt 0 ] || arches=(amd64)
for a in "${arches[@]}"; do
	case $a in amd64|386|arm64) ;; *) echo "build-profile: no architecture $a (amd64 386 arm64)" >&2; exit 2 ;; esac
done
. "$HERE/lib/tree-build.sh"	# TREE, GCC_DIR, RUST_DIR, CACHE; tb_groups, tb_projects
PROFILES=$TREE/sys/src/build/host/guest/profiles

# the profile's groups (sys/src/build/host/guest/profiles)
keep=$(awk -v p="$profile" '$1 == "profile" && $2 == p { for(i = 3; i <= NF; i++) printf " %s", $i }' "$PROFILES")
has(){ case " $keep " in *" $1 "*) return 0 ;; esac; return 1; }
gpu=0 ui=0
has gpu && gpu=1
has ui && ui=1

# the toolchains the groups need: said now, not after the base system's build (-n: a warning)
need(){ echo "build-profile: $profile needs $*: dist/bin/build-toolchains" >&2; [ $dry = 1 ] || exit 1; }
triple(){ case $1 in amd64) echo x86_64-pc-plan9;; 386) echo i686-pc-plan9;; arm64) echo aarch64-pc-plan9;; esac; }
for a in "${arches[@]}"; do
	if [ $a = amd64 ] && [ $((gpu + ui)) -gt 0 ] && [ ! -x "$GCC_DIR/build/$a/cross/bin/$(triple $a)-gcc" ]; then
		need "gcc's cross compiler for $a (Mesa, APE's ports)"
	fi
done
if [ $ui = 1 ] && [ ! -x "$RUST_DIR/rust/build/host/stage1/bin/rustc" ]; then
	need "Rust (wsys, ui, term)"
fi
run(){
	if [ $dry = 1 ]; then echo "step  $*"; return 0; fi
	echo "$(date +%H:%M) $*"
	"$@"
}

if [ $dry = 0 ]; then
	exec 9>"$HERE/.build-all.lock"
	flock -n 9 || { echo "build-profile: build-all, build-profile, mkcd or build-toolchains runs" >&2; exit 1; }
	tb_buildexe
fi
for a in "${arches[@]}"; do
	echo "build-profile: $profile for $a (groups:${keep:- none})"
	run tb_groups $a prep libc libs klibs cmds
	if [ $a = amd64 ]; then
		if [ $gpu = 1 ]; then
			run tb_groups $a linux
		else
			# the LinuxKPI and aux/rtw89 (WLAN, every profile), not the DRM drivers
			run tb_projects $a linux-base linux '^/sys/src/(linux|cmd/aux/rtw89)/'
		fi
	fi
	late=()
	[ $((gpu + ui)) -gt 0 ] && late+=(ape)
	[ $ui = 1 ] && late+=(rust)
	run tb_groups $a "${late[@]}" kernelgen kernel
	# the install step (build.$a.json's install) without its check: the kernel's a.out;
	# its absolute words are the tree's, as build.exe roots them at PLAN9
	post=$(python3 -c "import json, sys
for b in json.load(open(sys.argv[1])):
	if b['Name'] == 'install':
		print('\n'.join(' '.join(sys.argv[2] + w if w.startswith('/') else w for w in c.split())
			for c in b.get('Post', []) if 'check-install' not in c))" "$TREE/sys/src/build/build.$a.json" "$TREE")
	while read -r c; do
		[ -n "$c" ] && run bash -c "cd '$TREE' && $c"
	done <<< "$post"
	# the profile's omitted paths, as stage-dist.sh writes them
	om=$CACHE/build/$profile.$a.omitted
	if [ $dry = 0 ]; then
		mkdir -p "$CACHE/build"
		awk -v keep=" $keep " '/^[a-z]/ && $1 != "profile" && index(keep, " " $1 " ") == 0 { print "/" $2 }' "$PROFILES" |
			sed "s/\$objtype/$a/" > "$om"
	fi
	run bash -c "cd '$TREE' && objtype=$a python3 sys/src/build/step/check-install.py -r -x '$om' | grep -v '^broken'; exit \${PIPESTATUS[0]}"
done
# the stages check has for a profile's tree (amd64: the guests are amd64's)
checkargs=(static guest boot kencc gccmk)
if [ $check = 1 ]; then
	if [ $dry = 1 ]; then
		echo "step  dist/bin/check ${checkargs[*]}"
	else
		echo "$(date +%H:%M) build-profile: dist/bin/check ${checkargs[*]}"
		CHECK_LOCKED=1 "$HERE/bin/check" "${checkargs[@]}" || { echo "build-profile: check failed: no CD" >&2; exit 1; }
	fi
fi
if [ $dry = 0 ]; then
	exec 9>&-	# mkcd takes the lock itself
	echo "$(date +%H:%M) build-profile: $profile done (${arches[*]})"
fi

if [ $cd = 1 ]; then
	for a in "${arches[@]}"; do
		case $a in
		amd64|386)
			if [ $check = 1 ] && [ $dry = 0 ]; then
				# the CD mkcd made: its last line is ls -l of it
				log=$CACHE/build/mkcd-$profile.$a.log
				run "$HERE/bin/mkcd" "${mkcd[@]}" $profile $a | tee "$log"
				[ ${PIPESTATUS[0]} = 0 ] || exit 1
				img=$(tail -1 "$log" | awk '{print $NF}')
				echo "$(date +%H:%M) build-profile: dist/bin/check -iso $img"
				objtype=$a "$HERE/bin/check" -iso "$img" iso || { echo "build-profile: the CD $img failed its tests" >&2; exit 1; }
			else
				run "$HERE/bin/mkcd" "${mkcd[@]}" $profile $a
				[ $check = 0 ] || echo "step  dist/bin/check -iso (that CD) iso"
			fi ;;
		*) echo "build-profile: no CD for $a (mkcd: amd64, 386)" >&2 ;;
		esac
	done
elif [ $dry = 0 ]; then
	echo "the CD: dist/bin/mkcd $profile ${arches[0]} (or build-profile -cd)"
fi
