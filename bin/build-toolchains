#!/usr/bin/env bash
# build-toolchains [-n] [-from STEP] [ARCH...]: gcc, Rust and Go for 9front, from
# scratch, in the one order that works (wiki: Building). ARCH: amd64 386 arm64
# (default all three). Needs the sources: dist/bin/repos --sources. Only the
# toolchains: the tree of an installation profile is dist/bin/build-profile's.
#
#   tree-base      of the tree only what the toolchains are built against (gcc's
#                  sysroot, APE): prep, libc, the libraries, APE's libraries
#                  (dist/lib/tree-build.sh), for each ARCH
#   gcc-A          toolchain/gcc: build.sh cross hostlibs native plan9 (objtype=A)
#   rust-stage1    toolchain/rust: ./x build --stage 1 library (Linux + the ARCHes' targets)
#   llvm-A         scripts/build-llvm.sh: LLVM for 9front
#   rustc-A        ./x build --stage 2: rustc, rustdoc, rustfmt, clippy for 9front
#   stage1-again-A ./x build --stage 1 library (stage 2 removed the other targets' std)
#   cargo-A        scripts/build-cargo.sh: cargo for 9front
#   install-A      scripts/install.sh: out/A (/A/rust on 9front)
#   go-A           toolchain/go: scripts/build.sh, scripts/install.sh (the host Go once)
#
# Then: dist/bin/build-profile PROFILE (the tree for one profile), dist/bin/mkcd.
#
# Each step's output goes to dist/logs/<step>.log; the first failing step stops the run
# and prints its log's end. -from STEP starts there (after a fix: the steps before it
# are done; a STEP not in this run is refused, with the list). -n prints the steps
# only. One run at a time.
set -e
HERE=$(cd -P "$(dirname "$0")/.." && pwd -P)
dry=0 from=
while [ $# -gt 0 ]; do
	case $1 in
	-n)	dry=1; shift ;;
	-from)	from=$2; shift 2 ;;
	-*)	echo "usage: build-toolchains [-n] [-from STEP] [ARCH...]" >&2; exit 2 ;;
	*)	break ;;
	esac
done
arches=("$@")
[ ${#arches[@]} -gt 0 ] || arches=(amd64 386 arm64)
. "$HERE/lib/tree-build.sh"	# TREE, GCC_DIR, RUST_DIR, GO_DIR; tb_groups, tb_projects
LOGS=$HERE/logs
mkdir -p "$LOGS"
if [ $dry = 0 ]; then
	exec 8>"$HERE/.build-toolchains.lock"
	flock -n 8 || { echo "build-toolchains: another run is going on" >&2; exit 1; }
fi

rtarget(){ case $1 in amd64) echo x86_64-unknown-plan9;; 386) echo i686-unknown-plan9;; arm64) echo aarch64-unknown-plan9;;
	*) echo "build-toolchains: no architecture $1 (amd64 386 arm64)" >&2; exit 2;; esac; }
for a in "${arches[@]}"; do rtarget "$a" >/dev/null; done
# -from: one of the steps of this run (an unknown name would skip them all)
# the steps' old names: tree-first is tree-base now, tree is build-profile's
case $from in
tree-first) from=tree-base ;;
tree) echo "build-toolchains: the tree is not built here any more: dist/bin/build-profile PROFILE ${arches[*]}" >&2; exit 2 ;;
esac
if [ -n "$from" ]; then
	steps="tree-base"
	for a in "${arches[@]}"; do steps="$steps gcc-$a"; done
	steps="$steps rust-stage1"
	for a in "${arches[@]}"; do steps="$steps llvm-$a rustc-$a stage1-again-$a cargo-$a install-$a"; done
	for a in "${arches[@]}"; do steps="$steps go-$a"; done
	case " $steps " in *" $from "*) ;; *)
		echo "build-toolchains: no step $from in this run; the steps: $steps" >&2; exit 2 ;; esac
fi

step(){
	local name=$1 t; shift
	if [ -n "$from" ]; then
		[ "$name" = "$from" ] || { echo "skip  $name"; return 0; }
		from=
	fi
	if [ $dry = 1 ]; then echo "step  $name: $*"; return 0; fi
	t=$(date +%s)
	touch "$LOGS/.start"
	echo "$(date +%H:%M) start $name"
	if "$@" > "$LOGS/$name.log" 2>&1; then
		echo "$(date +%H:%M) ok    $name ($(( ($(date +%s) - t) / 60 )) min)"
	else
		echo "$(date +%H:%M) FAIL  $name (log $LOGS/$name.log)"
		tail -20 "$LOGS/$name.log"
		# steps that keep logs of their own (build-llvm.sh, build-cargo.sh, gcc's
		# build.sh): those written during the step, the newest one's end
		mapfile -t own < <(find "$GCC_DIR" -maxdepth 1 -name '*.log' -newer "$LOGS/.start"; \
			find "$RUST_DIR/logs" "$GO_DIR" -maxdepth 1 -name '*.log' -newer "$LOGS/.start" 2>/dev/null)
		if [ ${#own[@]} -gt 0 ]; then
			echo "logs written by the step: ${own[*]}"
			newest=$(ls -t "${own[@]}" | head -1)
			echo "== end of $newest"
			tail -20 "$newest"
		fi
		echo "after a fix: $0 -from $name ${arches[*]}"
		exit 1
	fi
}

all=x86_64-unknown-linux-gnu
for a in "${arches[@]}"; do all=$all,$(rtarget "$a"); done

# of the tree what the toolchains need, with build-all's lock (the tree's objects):
# a function, under step's if (no set -e): every command checked
treebase(){
	exec 9>"$HERE/.build-all.lock"
	flock -n 9 || { echo "build-toolchains: build-all or build-profile runs"; return 1; }
	tb_buildexe || return 1
	for a in "${arches[@]}"; do
		echo "tree-base: $a: prep, libc, the libraries"
		tb_groups $a prep libc libs || return 1
		echo "tree-base: $a: APE's libraries"
		tb_projects $a toolchain-base cmds '^/sys/src/ape/lib/' || return 1
	done
	exec 9>&-
}
step tree-base treebase
for a in "${arches[@]}"; do
	step gcc-$a env objtype=$a bash -c "cd '$GCC_DIR' && ./build.sh cross hostlibs native plan9"
done
step rust-stage1 bash -c "cd '$RUST_DIR/rust' && ./x build --stage 1 library --target $all"
for a in "${arches[@]}"; do
	t=$(rtarget "$a")
	step llvm-$a env objtype=$a bash -c "cd '$RUST_DIR' && scripts/build-llvm.sh"
	step rustc-$a bash -c "cd '$RUST_DIR/rust' && ./x build --stage 2 --host $t --target $t compiler/rustc src/tools/rustdoc src/tools/rustfmt src/tools/clippy"
	step stage1-again-$a bash -c "cd '$RUST_DIR/rust' && ./x build --stage 1 library --target $all"
	step cargo-$a env objtype=$a bash -c "cd '$RUST_DIR' && scripts/build-cargo.sh"
	step install-$a env objtype=$a bash -c "cd '$RUST_DIR' && scripts/install.sh"
done
host=1
for a in "${arches[@]}"; do
	step go-$a env objtype=$a HOST=$host bash -c "cd '$GO_DIR' && scripts/build.sh && scripts/install.sh"
	host=0
done
if [ $dry = 0 ]; then
	echo "$(date +%H:%M) build-toolchains: done (${arches[*]})"
	echo "next: the tree of a profile, e.g. dist/bin/build-profile full; then dist/bin/mkcd full"
fi
